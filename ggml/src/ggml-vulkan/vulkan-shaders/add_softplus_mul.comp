#version 450

// ADD of a per-row bias + SOFTPLUS + MUL by a per-row factor in one dispatch (the gated delta net's
// gate = softplus(alpha + dt) * a). Same arithmetic as add.comp and the softplus_mul unary: f32 add,
// op_softplus, then the multiply, so the result does not change.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly  buffer X    { float data_x[];    };
layout(binding = 1) readonly  buffer Bias { float data_bias[]; };
layout(binding = 2) readonly  buffer Fac  { float data_fac[];  };
layout(binding = 3) writeonly buffer D    { float data_d[];    };

layout(push_constant) uniform PushConstants {
    uint ne;  // elements of x and d (contiguous)
    uint ne0; // row length; bias and factor hold one row
};

float op_softplus(float x) {
    return (x > 20.0f) ? x : log(1.0f + exp(x));
}

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= ne) {
        return;
    }
    const uint c = i % ne0;
    const float sum = data_x[i] + data_bias[c];
    data_d[i] = op_softplus(sum) * data_fac[c];
}
