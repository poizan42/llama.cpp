#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

#include "mul_mat_vec_base.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

// dedicated iq4_nl mat-vec, after mul_mat_vec_iq4_xs.comp: a 32-weight block has the layout of one iq4_xs subblock
// the workgroup is split into NUM_ROWS row groups, so all threads have work also when a row has few blocks
// (the qwen3.8-flash-next expert down projection has k = 640, 20 blocks per row)

// threads per block; each thread reads 4/PARTS words of 8 weights
const uint PARTS = 2;
const uint WPT = 4 / PARTS;

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_offset, b_offset, d_offset;
    get_offsets(a_offset, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;

    const uint tid  = gl_LocalInvocationID.x;
    const uint tpr  = max(gl_WorkGroupSize.x / NUM_ROWS, 1u); // threads per row; the pipelines use NUM_ROWS <= workgroup size
    const uint row  = tid / tpr;
    const uint lane = tid % tpr;

    FLOAT_TYPE acc[NUM_COLS];
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        acc[j] = FLOAT_TYPE(0);
    }

    if (row < num_rows) {
        const uint ib0 = a_offset + (first_row + row) * num_blocks_per_row;
        const uint units = num_blocks_per_row * PARTS;

        for (uint u = lane; u < units; u += tpr) {
            const uint ib = u / PARTS;
            const uint l0 = (u % PARTS) * WPT;
            const uint ibi = ib0 + ib;
            const uint y_idx = ib * QUANT_K;

            FLOAT_TYPE sum[NUM_COLS];
            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                sum[j] = FLOAT_TYPE(0);
            }

            [[unroll]] for (uint w = 0; w < WPT; ++w) {
                const uint l = l0 + w;
                // the 18-byte block is only 2-byte aligned, so build the word from two 16-bit loads
                const uint32_t qw = uint32_t(data_a_packed16[ibi].qs[2 * l]) | (uint32_t(data_a_packed16[ibi].qs[2 * l + 1]) << 16);
                const u8vec4 q0 = unpack8(qw & 0x0F0F0F0F);        // weights 4l .. 4l+3
                const u8vec4 q1 = unpack8((qw >> 4) & 0x0F0F0F0F); // weights 16+4l .. 16+4l+3

                [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                    const vec4 b0 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y_idx) / 4 + l]);
                    const vec4 b1 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y_idx) / 4 + 4 + l]);

                    sum[j] = fma(FLOAT_TYPE(b0.x), FLOAT_TYPE(kvalues_iq4nl[q0.x]),
                            fma(FLOAT_TYPE(b0.y), FLOAT_TYPE(kvalues_iq4nl[q0.y]),
                            fma(FLOAT_TYPE(b0.z), FLOAT_TYPE(kvalues_iq4nl[q0.z]),
                            fma(FLOAT_TYPE(b0.w), FLOAT_TYPE(kvalues_iq4nl[q0.w]),
                            fma(FLOAT_TYPE(b1.x), FLOAT_TYPE(kvalues_iq4nl[q1.x]),
                            fma(FLOAT_TYPE(b1.y), FLOAT_TYPE(kvalues_iq4nl[q1.y]),
                            fma(FLOAT_TYPE(b1.z), FLOAT_TYPE(kvalues_iq4nl[q1.z]),
                            fma(FLOAT_TYPE(b1.w), FLOAT_TYPE(kvalues_iq4nl[q1.w]),
                            sum[j]))))))));
                }
            }

            const FLOAT_TYPE d = FLOAT_TYPE(data_a_packed16[ibi].d);
            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                acc[j] = fma(d, sum[j], acc[j]);
            }
        }
    }

    // each thread has one row; the reduction sums all threads per row, so the other rows stay zero
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            temp[j][n] = (n == row) ? acc[j] : FLOAT_TYPE(0);
        }
    }

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    init_iq_shmem(gl_WorkGroupSize);

    // do NUM_ROWS at a time, unless there aren't enough remaining rows
    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
